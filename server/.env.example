# Generate a unique UUID once per Linux node; preserve it across upgrades.
ORANGESPACE_NODE_ID=4eef0765-2443-4879-badb-02967baac185
# Must exist with owner=service account, mode=0700 (or be created by it).
ORANGESPACE_DATA_ROOT=/var/lib/orangespace/files
ORANGESPACE_DATABASE_CONFIG=/etc/orangespace/database.json
ORANGESPACE_TOKEN_TTL=28800
ORANGESPACE_MAX_UPLOAD_BYTES=1073741824
ORANGESPACE_LOGIN_ATTEMPTS=10
ORANGESPACE_LOGIN_WINDOW=300
