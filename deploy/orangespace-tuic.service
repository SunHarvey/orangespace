[Unit]
Description=OrangeSpace TUIC gateway (sing-box 1.14.4)
After=network-online.target unbound.service
Wants=network-online.target

[Service]
Type=simple
User=orangespace-tunnel
Group=orangespace-tunnel
ExecStartPre=/usr/local/bin/sing-box check -c /etc/orangespace/tuic.json
ExecStart=/usr/local/bin/sing-box run -c /etc/orangespace/tuic.json
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
UMask=0077
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
