[Unit]
Description=OrangeSpace isolated Linux node %i
After=network.target

[Service]
Type=simple
User=orangespace-node-%i
Group=orangespace-node-%i
WorkingDirectory=/opt/orangespace/server
ExecStart=/opt/orangespace/server/.venv/bin/python -m orangespace_node.runtime --profile /etc/orangespace-linux-node/%i/runtime.json serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
KillSignal=SIGTERM
KillMode=mixed
SuccessExitStatus=SIGTERM
UMask=0077
LimitCORE=0
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/orangespace-node-%i
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
