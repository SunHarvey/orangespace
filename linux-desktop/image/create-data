#!/usr/bin/env bash
# Creates only a new image; does not open existing disks for writing.
set -euo pipefail
umask 077
export PATH="$PATH:/usr/sbin:/sbin"
if [[ $# -lt 1 || $# -gt 2 || ! ${2:-24} =~ ^[1-9][0-9]{0,2}$ ]]; then
    echo "usage: create-data NEW-DATA.qcow2 [size-in-GiB, default 24]" >&2
    exit 2
fi
dest=$(realpath -m "$1")
[[ ! -e $dest ]] || { echo "output already exists" >&2; exit 1; }
work=$(mktemp -d "$(dirname "$dest")/.os-data.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
truncate -s "${2:-24}G" "$work/data.raw"
mkfs.ext4 -q -F -L OrangeSpaceHome "$work/data.raw"
qemu-img convert -f raw -O qcow2 "$work/data.raw" "$work/data.qcow2"
qemu-img check "$work/data.qcow2"
ln "$work/data.qcow2" "$dest"
printf 'Created %s\n' "$dest"
