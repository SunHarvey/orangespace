#!/usr/bin/env bash
# Dedicated x86_64 Linux builder with Docker Engine and libguestfs.
set -euo pipefail
umask 077
if [[ $# -lt 2 || $# -gt 3 ]]; then
    echo "usage: build-qcow2 VERIFIED-DEBIAN-13-AMD64.qcow2 NEW-OUTPUT.qcow2 [PRIVATE-NODES-DIR]" >&2
    exit 2
fi
[[ $(uname -sm) == "Linux x86_64" ]] || { echo "use an x86_64 Linux build machine" >&2; exit 1; }
base=$(realpath "$1")
dest=$(realpath -m "$2")
[[ -f $base && ! -e $dest ]] || { echo "need an existing base and a new output path" >&2; exit 1; }
for tool in docker curl sha256sum tar virt-resize virt-customize qemu-img; do
    command -v "$tool" >/dev/null
done
project=$(cd "$(dirname "$0")/.." && pwd)
# Stage alongside the destination for atomic publication.
work=$(mktemp -d "$(dirname "$dest")/.os-image.XXXXXXXX")
trap 'rm -rf -- "$work"' EXIT
mkdir -p "$work/orangespace" "$work/seed"
for dir in bridge guest network image; do
    cp -R "$project/$dir" "$work/orangespace/"
done
find "$work/orangespace" -type d -name __pycache__ -prune -exec rm -r {} +
docker build --platform linux/amd64 -t orangespace/desktop:dev "$project/guest"
docker save -o "$work/seed/desktop.tar" orangespace/desktop:dev
curl -fsSL --proto '=https' --proto-redir '=https' https://raw.githubusercontent.com/moby/moby/v25.0.5/profiles/seccomp/default.json -o "$work/moby.json"
python3 "$project/guest/build-seccomp" "$work/moby.json" > "$work/desktop-seccomp.json"

version=1.14.4
archive="sing-box-$version-linux-amd64"
curl -fsSL --proto '=https' --proto-redir '=https' "https://github.com/SagerNet/sing-box/releases/download/v$version/$archive.tar.gz" -o "$work/sing.tar.gz"
echo "699a1b510aa4396b2176d32d1181920399ebf1e267835da6f3b598d0f7c24968  $work/sing.tar.gz" | sha256sum -c - >/dev/null
tar -xOzf "$work/sing.tar.gz" "$archive/sing-box" > "$work/sing-box"
chmod 0755 "$work/sing-box"

# Debian genericcloud GPT images place their root filesystem on partition 1.
qemu-img create -f qcow2 "$work/system.qcow2" 24G >/dev/null
virt-resize --expand /dev/sda1 "$base" "$work/system.qcow2"
args=(--format qcow2 -a "$work/system.qcow2" --install docker.io,docker-cli,iproute2,nftables,acpid,python3,ca-certificates,apparmor
      --mkdir /opt --copy-in "$work/orangespace:/opt"
      --mkdir /var/lib/orangespace --copy-in "$work/seed:/var/lib/orangespace"
      --mkdir /etc/orangespace --copy-in "$work/desktop-seccomp.json:/etc/orangespace"
      --copy-in "$work/sing-box:/usr/local/bin"
      --run-command '/bin/sh /opt/orangespace/image/configure-root')
if [[ $# == 3 ]]; then
    [[ -d $3 ]] || { echo "node directory does not exist" >&2; exit 1; }
    shopt -s nullglob
    files=("$3"/*.json)
    for node in "${files[@]}"; do
        name=$(basename "$node")
        [[ $name =~ ^[0-9a-f]{8}-([0-9a-f]{4}-){3}[0-9a-f]{12}\.json$ && ! -L $node ]] || exit 1
        args+=(--upload "$node:/etc/orangespace/nodes/$name" --chmod "0600:/etc/orangespace/nodes/$name" --chown "0:0:/etc/orangespace/nodes/$name")
    done
fi
virt-customize "${args[@]}"
qemu-img check "$work/system.qcow2"
# link(2) cannot replace another build's image.
ln "$work/system.qcow2" "$dest"
printf 'Created %s\n' "$dest"
