[Unit]
Description=OrangeSpace private desktop control channel
Requires=docker.service orangespace-image.service apparmor.service
After=docker.service orangespace-image.service systemd-modules-load.service apparmor.service
StartLimitIntervalSec=0
RequiresMountsFor=/var/lib/orangespace/desktop

[Service]
Type=simple
ExecStartPre=/usr/bin/mountpoint --quiet /var/lib/orangespace/desktop
ExecStartPre=/usr/bin/python3 /opt/orangespace/bridge/cleanup.py
ExecStart=/usr/bin/python3 /opt/orangespace/bridge/guest.py
ExecStopPost=/usr/bin/python3 /opt/orangespace/bridge/cleanup.py
Restart=always
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
