#!/bin/sh
# Run as root inside the offline Debian image, after package and asset installation.
set -eu
umask 022
src=/opt/orangespace
install -d -m 0755 /var/lib/orangespace/desktop /etc/docker /etc/systemd/network /etc/cloud /etc/modules-load.d
install -d -m 0700 /etc/orangespace/nodes
install -m 0644 "$src/guest/orangespace-desktop.apparmor" /etc/apparmor.d/orangespace-desktop
install -m 0644 "$src/image/orangespace-agent.service" "$src/image/orangespace-image.service" /etc/systemd/system/
chmod 0644 "$src/guest/resolv.conf"
chmod 0755 "$src/guest/desktop" "$src/network/up" "$src/network/down" "$src/network/status" \
    "$src/network/probe" "$src/network/configure" "$src/image/load-desktop"

printf '%s\n' '{"bridge":"none","iptables":false,"ip6tables":false,"ip-forward":false,"userland-proxy":false}' > /etc/docker/daemon.json
printf '%s\n' 'net.ipv4.ip_forward=1' > /etc/sysctl.d/80-orangespace.conf
printf '%s\n' qemu_fw_cfg virtio_console > /etc/modules-load.d/orangespace.conf
printf '[Match]\nName=en* eth*\n[Network]\nDHCP=ipv4\n' > /etc/systemd/network/10-orangespace.network
mount_line='/dev/disk/by-id/virtio-OrangeSpaceData /var/lib/orangespace/desktop ext4 defaults,nosuid,nodev,nofail,x-systemd.device-timeout=30s 0 2'
grep -qxF "$mount_line" /etc/fstab || printf '%s\n' "$mount_line" >> /etc/fstab
touch /etc/cloud/cloud-init.disabled
# The controlled virtio channel is the only guest management endpoint.
# Debian cloud images omit SSH host keys until cloud-init runs.
systemctl mask ssh.service ssh.socket
systemctl enable docker.service acpid.service apparmor.service systemd-networkd.service orangespace-agent.service
