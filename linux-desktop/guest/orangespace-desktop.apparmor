abi <abi/4.0>,
#include <tunables/global>

# Used only in the managed Debian guest. DAC, mount, capability and seccomp
# restrictions of the per-desktop container remain active layers.
profile orangespace-desktop flags=(attach_disconnected,mediate_deleted) {
  file,
  network,
  unix,
  dbus,
  capability,
  userns,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=/usr/sbin/runc,
  signal (send,receive) peer=orangespace-desktop,
  ptrace (trace,read,tracedby,readby) peer=orangespace-desktop,

  deny mount,
  deny /sys/** wklx,
  deny /sys/firmware/** r,
  deny /sys/kernel/security/** r,
  deny /sys/devices/virtual/powercap/** r,
  deny /proc/* w,
  deny /proc/sys/** w,
  deny /proc/{kcore,sysrq-trigger} rwklx,
  deny /dev/virtio-ports/** rwklx,
  deny /run/docker.sock rwklx,
}
