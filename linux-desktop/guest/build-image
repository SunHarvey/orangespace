#!/bin/sh
# Run once when provisioning a dedicated Debian guest.
set -eu
cd "$(dirname "$0")"
umask 022
install -d -m 0755 /etc/orangespace
install -m 0644 orangespace-desktop.apparmor /etc/apparmor.d/orangespace-desktop
apparmor_parser -r /etc/apparmor.d/orangespace-desktop
source_file=$(mktemp)
profile_file=$(mktemp /etc/orangespace/.seccomp.XXXXXXXX)
trap 'rm -f "$source_file" "$profile_file"' EXIT
curl --fail --silent --show-error --location --proto '=https' --proto-redir '=https' \
    https://raw.githubusercontent.com/moby/moby/v25.0.5/profiles/seccomp/default.json -o "$source_file"
./build-seccomp "$source_file" > "$profile_file"
chmod 0644 "$profile_file"
arch=$(docker version --format '{{.Server.Arch}}')
case "$arch" in amd64|arm64) ;; *) echo "unsupported guest architecture: $arch" >&2; exit 1;; esac
docker build --platform "linux/$arch" --pull --tag orangespace/desktop:dev .
mv "$profile_file" /etc/orangespace/desktop-seccomp.json
