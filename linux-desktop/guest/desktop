#!/usr/bin/env python3
"""Root-only desktop lifecycle inside the OrangeSpace WSL distribution.

Called by the guest agent (wsl/agent.py). One sandbox =
  - a Podman container `osdesk-<sandbox>` (desktop image), rootless inside a
    fixed per-sandbox UID/GID block, no network until its gateway attaches,
    read-only root, no capabilities, seccomp, resource limits;
  - a private virtual X display (Xvnc, systemd unit `osdisp-<sandbox>`) that
    keeps running without any window: it has no network and no access to
    WSLg or /mnt. Its /tmp/.X11-unix is this sandbox's display directory, the
    only display path the container mounts;
  - a viewer window (vncviewer, a WSLg client, unit `osview-<sandbox>`) that
    shows the display over a private Unix socket the container never sees.
    Closing the window leaves the desktop running and `start` reopens it; if
    WSLg goes away (e.g. a remote session disconnects), the viewer retries
    until it can show the desktop again. Clipboard transfer is disabled on
    both ends, so nothing crosses between the sandbox and Windows;
  - a persistent HOME under instances/<sandbox>. Its node lease (from the
    client, renewed by it) lives on tmpfs only.

  desktop start     USER SANDBOX NODE TITLE
  desktop stop      USER SANDBOX
  desktop status    USER SANDBOX
  desktop lease     USER SANDBOX NODE   < lease.json
  desktop renew     USER SANDBOX TUNNEL REMAINING_MS
  desktop delete    USER SANDBOX        (removes the sandbox's local data)
  desktop files-list USER SANDBOX              (regular files in ~/Downloads)
  desktop files-put  USER SANDBOX NAME SIZE    < exactly SIZE bytes
  desktop files-get  USER SANDBOX NAME         > {"size":N} line, then N bytes

The files-* operations move node files to and from the sandbox's Downloads
directory for the client. They open the sandbox's HOME as root and then drop
to the sandbox's own UID before touching anything in it, so whatever the
sandbox placed there (symlinks, links, special files) reaches nothing that
the sandbox itself could not.

Prints one JSON object.
"""
import contextlib
import fcntl
import json
import os
from pathlib import Path
import pwd
import shutil
import stat
import struct
import subprocess
import sys
import syslog
import time
import uuid

ROOT = Path("/var/lib/orangespace/desktop")
DISPLAY_ROOT = Path("/run/orangespace/display")   # per sandbox: X socket + cookie (container-visible)
VIEW_ROOT = Path("/run/orangespace/view")         # per sandbox: viewer socket (never container-visible)
NETWORK = Path("/opt/orangespace/network")
GUEST = Path("/opt/orangespace/guest")
PODMAN = ("/usr/bin/podman",)
IMAGE = "localhost/orangespace/desktop:current"   # loaded by the installer (wsl/system load-image)
SECCOMP = Path("/etc/orangespace/desktop-seccomp.json")
WSLG_X11 = "/mnt/wslg/.X11-unix"
DISPLAY_UID_BASE = 190000        # display + viewer of slot s run as uid 190000+s: per sandbox,
                                 # outside every container's UID block
LABEL = "io.orangespace.desktop."
GUEST_UID = 1000                 # the desktop user inside the container
UID_BASE, UID_BLOCK, MAX_SLOTS = 200000, 65536, 64
DISPLAY_BASE = 100               # X display number = DISPLAY_BASE + slot
SCREEN = "1440x900"
MAX_POLICY_BYTES = 32768
DOWNLOADS = "Downloads"
MAX_LISTED = 1000
COPY_CHUNK = 1 << 16
HIDDEN_SUFFIXES = (".crdownload", ".part")   # downloads still in progress


class DesktopError(Exception):
    pass


def identifier(value):
    if str(uuid.UUID(value)) != value:
        raise ValueError("expected a canonical lower-case UUID")
    return value


def window_title(value):
    # Shown as the Windows window title. Printable text only, bounded.
    if not isinstance(value, str) or not 0 < len(value) <= 64 or any(ord(c) < 32 or ord(c) == 127 for c in value):
        raise ValueError("invalid window title")
    return value


def execute(*args, timeout=30):
    try:
        return subprocess.run(args, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                              timeout=timeout, check=False)
    except subprocess.TimeoutExpired as exc:
        raise DesktopError(f"{Path(args[0]).name} timed out") from exc


def checked(*args, timeout=30):
    result = execute(*args, timeout=timeout)
    if result.returncode:
        # Report only the command and return code. Daemon stderr may contain private paths.
        verb = args[len(PODMAN)] if args[:len(PODMAN)] == PODMAN else args[1] if len(args) > 1 else ""
        raise DesktopError(f"{Path(args[0]).name} {verb} failed ({result.returncode})")
    return result.stdout.strip()


def container_name(sandbox):
    return "osdesk-" + sandbox


def display_unit(sandbox):
    return "osdisp-" + sandbox


def inspect(sandbox, user):
    name = container_name(sandbox)
    cid = checked(*PODMAN, "ps", "-aq", "--no-trunc", "--filter", f"name=^{name}$")
    if not cid:
        return None
    info, = json.loads(checked(*PODMAN, "inspect", "--type", "container", cid))
    labels = info["Config"]["Labels"] or {}
    if (info["Name"].lstrip("/") != name or labels.get(LABEL + "user") != user
            or labels.get(LABEL + "sandbox") != sandbox or not labels.get(LABEL + "node")):
        raise DesktopError("container name belongs to another desktop")
    return info


def gateway(operation, sandbox, *args):
    result = execute(str(NETWORK / operation), sandbox, *args)
    if result.returncode and operation != "status":
        # Gateway errors name the failed step, never credentials. Keep the
        # reason in the distribution's journal; the reply stays generic.
        reason = (result.stderr or "").strip().splitlines()[-1:] or ["no message"]
        syslog.openlog("orangespace-desktop")
        syslog.syslog(syslog.LOG_WARNING, f"gateway {operation} {sandbox} failed: {reason[0][:200]}")
    return result.returncode == 0


def disconnect(sandbox):
    if not gateway("down", sandbox):
        raise DesktopError("sandbox gateway cleanup failed")


@contextlib.contextmanager
def locked(path):
    with path.open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def write_private(path, text, mode):
    temp = path.with_name("." + path.name + ".new")
    with temp.open("w") as out:
        out.write(text)
        out.flush()
        os.fsync(out.fileno())
    temp.chmod(mode)
    os.replace(temp, path)


@contextlib.contextmanager
def ownership(user, sandbox, claim):
    for required in (ROOT, ROOT / "locks", ROOT / "instances"):
        required.mkdir(mode=0o700, parents=True, exist_ok=True)
    with locked(ROOT / "locks" / sandbox):
        directory = ROOT / "instances" / sandbox
        owner = directory / "owner"
        if owner.exists() and owner.read_text().strip() != user:
            raise DesktopError("sandbox belongs to another account")
        if claim and not owner.exists():
            directory.mkdir(mode=0o700, exist_ok=True)
            write_private(owner, user + "\n", 0o600)
        yield directory


def slot_of(directory):
    """This sandbox's fixed UID/GID block and display number, allocated once.

    Distinct blocks mean that code escaping one container runs as a host UID
    that owns nothing of any other sandbox.
    """
    path = directory / "slot"
    if path.exists():
        slot = int(path.read_text())
        if not 0 <= slot < MAX_SLOTS:
            raise DesktopError("corrupt sandbox slot")
        return slot
    with locked(ROOT / "locks" / ".slots"):
        used = set()
        for other in (ROOT / "instances").iterdir():
            try:
                used.add(int((other / "slot").read_text()))
            except (OSError, ValueError):
                pass
        free = next((s for s in range(MAX_SLOTS) if s not in used), None)
        if free is None:
            raise DesktopError("too many sandboxes on this computer")
        write_private(path, f"{free}\n", 0o600)
        return free


def host_uid(slot):
    return UID_BASE + slot * UID_BLOCK + GUEST_UID


def authority(cookie, number):
    # One MIT-MAGIC-COOKIE-1 entry for this display, any host (FamilyWild).
    fields = [b"", str(number).encode(), b"MIT-MAGIC-COOKIE-1", cookie]
    return b"\xff\xff" + b"".join(struct.pack("!H", len(s)) + s for s in fields)


def display_uid(slot):
    return DISPLAY_UID_BASE + slot


def display_account(slot):
    """The system account (uid = gid = display_uid) of this slot's display and
    viewer, created on first use; systemd needs a passwd entry to run as it."""
    uid, name = display_uid(slot), f"osdisp{slot}"
    try:
        entry = pwd.getpwuid(uid)
    except KeyError:
        checked("/usr/sbin/groupadd", "--system", "--gid", str(uid), name)
        checked("/usr/sbin/useradd", "--system", "--uid", str(uid), "--gid", str(uid), "--no-create-home",
                "--home-dir", "/nonexistent", "--shell", "/usr/sbin/nologin", name)
        return uid
    if entry.pw_name != name or entry.pw_gid != uid:
        raise DesktopError("display account conflicts with an existing user")
    return uid


def view_unit(sandbox):
    return "osview-" + sandbox


# Common confinement of both units: their own UID, no new privileges, no
# network namespace access, read-only system, no Windows drives.
CONFINED = ("--property=NoNewPrivileges=yes", "--property=PrivateNetwork=yes",
            "--property=PrivateTmp=yes", "--property=ProtectSystem=strict", "--property=ProtectHome=yes",
            "--property=RestrictSUIDSGID=yes", "--property=LockPersonality=yes", "--property=UMask=0077")
NO_CLIPBOARD_SERVER = ("-AcceptCutText=0", "-SendCutText=0", "-SetPrimary=0", "-SendPrimary=0")
NO_CLIPBOARD_VIEWER = ("-AcceptClipboard=0", "-SendClipboard=0", "-SetPrimary=0", "-SendPrimary=0")


def start_display(sandbox, slot, title):
    """Starts this sandbox's virtual display and returns its display directory and number."""
    number = DISPLAY_BASE + slot
    directory, view = DISPLAY_ROOT / sandbox, VIEW_ROOT / sandbox
    stop_display(sandbox)
    uid = display_account(slot)
    # Explicit modes: this runs under umask 077, and the display account must
    # be able to reach its own directories (and nothing else under them).
    for root in (DISPLAY_ROOT.parent, DISPLAY_ROOT, VIEW_ROOT):
        root.mkdir(parents=True, exist_ok=True)
        root.chmod(0o755)
    directory.mkdir()
    directory.chmod(0o755)
    view.mkdir()
    view.chmod(0o700)
    auth = directory / "Xauthority"
    auth.write_bytes(authority(os.urandom(16), number))
    auth.chmod(0o444)
    for path in (directory, view):
        os.chown(path, uid, uid)      # the X server and the viewer create their sockets here
    checked("/usr/bin/systemd-run", "--quiet", "--collect", "--unit=" + display_unit(sandbox),
            f"--uid={uid}", f"--gid={uid}", *CONFINED, "--property=InaccessiblePaths=/mnt",
            f"--property=BindPaths={directory}:/tmp/.X11-unix", f"--property=ReadWritePaths={view}",
            "/usr/bin/Xvnc", f":{number}", "-auth", "/tmp/.X11-unix/Xauthority", "-geometry", SCREEN,
            "-depth", "24", "-nolisten", "tcp", "-noreset", "-extension", "MIT-SHM",
            "-rfbport=-1", f"-rfbunixpath={view}/rfb", "-rfbunixmode=0600", "-SecurityTypes=None",
            "-AlwaysShared=1", *NO_CLIPBOARD_SERVER, "-desktop", title)
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        if all(p.exists() and stat.S_ISSOCK(p.lstat().st_mode) for p in (directory / f"X{number}", view / "rfb")):
            return directory, number
        time.sleep(0.1)
    stop_display(sandbox)
    raise DesktopError("desktop display did not start")


def open_window(sandbox, slot):
    """Shows the display in a Windows window (no-op while one is open)."""
    if window_open(sandbox):
        return
    view, uid = VIEW_ROOT / sandbox, display_uid(slot)
    # WSLg can disappear (a remote session disconnecting restarts it); the
    # viewer exits with an error then and retries until it can connect again.
    # Closing the window exits cleanly and is not retried.
    checked("/usr/bin/systemd-run", "--quiet", "--collect", "--unit=" + view_unit(sandbox),
            f"--uid={uid}", f"--gid={uid}", *CONFINED,
            f"--property=BindsTo={display_unit(sandbox)}.service", f"--property=After={display_unit(sandbox)}.service",
            "--property=Restart=on-failure", "--property=RestartSec=3", "--property=StartLimitIntervalSec=0",
            f"--property=BindReadOnlyPaths={WSLG_X11}:/tmp/.X11-unix", f"--property=ReadWritePaths={view}",
            f"--setenv=HOME={view}", "--setenv=DISPLAY=:0", "--setenv=WAYLAND_DISPLAY=",
            "/usr/bin/vncviewer", "-SecurityTypes=None", "-Shared=1", "-RemoteResize=1", "-MenuKey=None",
            "-ReconnectOnError=0", "-AlertOnFatalError=0", *NO_CLIPBOARD_VIEWER, "-geometry", SCREEN,
            str(view / "rfb"))


def stop_display(sandbox):
    execute("/usr/bin/systemctl", "stop", view_unit(sandbox) + ".service", display_unit(sandbox) + ".service",
            timeout=15)
    for root in (DISPLAY_ROOT, VIEW_ROOT):
        shutil.rmtree(root / sandbox, ignore_errors=True)


def unit_active(unit):
    return execute("/usr/bin/systemctl", "is-active", "--quiet", unit + ".service").returncode == 0


def display_running(sandbox):
    return unit_active(display_unit(sandbox))


def window_open(sandbox):
    # "activating" (waiting to retry after losing WSLg) counts as open: the
    # window comes back by itself.
    state = execute("/usr/bin/systemctl", "is-active", view_unit(sandbox) + ".service").stdout.strip()
    return state in ("active", "activating", "reloading")


def prepare_home(directory, sandbox, slot):
    home = directory / "home"
    if not home.exists():
        home.mkdir(mode=0o700)
    uid = host_uid(slot)
    if home.stat().st_uid != uid:
        os.chown(home, uid, uid)
    machine_id = directory / "machine-id"
    machine_id.write_text(uuid.UUID(sandbox).hex + "\n")
    machine_id.chmod(0o444)
    return home, machine_id


def create(user, sandbox, node, directory, slot, display, number):
    home, machine_id = prepare_home(directory, sandbox, slot)
    base = UID_BASE + slot * UID_BLOCK
    flags = ["--name", container_name(sandbox), "--hostname", "osdesk",
             "--pull=never", "--network=none", "--ipc=private", "--init", "--read-only",
             "--user", f"{GUEST_UID}:{GUEST_UID}",
             f"--uidmap=0:{base}:{UID_BLOCK}", f"--gidmap=0:{base}:{UID_BLOCK}",
             "--cap-drop=ALL", "--security-opt=no-new-privileges",
             f"--security-opt=seccomp={SECCOMP}",
             "--memory=2g", "--memory-swap=2g", "--pids-limit=512", "--cpu-shares=512",
             "--shm-size=256m", "--tmpfs", "/tmp:rw,nosuid,nodev,mode=1777,size=192m",
             # U: owned by the container user (Podman's form of uid=/gid=).
             "--tmpfs", f"/run/user/{GUEST_UID}:rw,nosuid,nodev,noexec,mode=0700,size=16m,U",
             "--log-driver=k8s-file", "--log-opt=max-size=5mb",
             "--env", f"DISPLAY=:{number}", "--env", "XAUTHORITY=/tmp/.X11-unix/Xauthority"]
    for key, value in (("user", user), ("sandbox", sandbox), ("node", node)):
        flags.extend(["--label", LABEL + key + "=" + value])
    for source, target, writable in ((home, "/home/desktop", True),
                                      (display, "/tmp/.X11-unix", False),
                                      (machine_id, "/etc/machine-id", False),
                                      (GUEST / "resolv.conf", "/etc/resolv.conf", False)):
        mount = f"type=bind,src={source},dst={target}"
        flags.extend(["--mount", mount if writable else mount + ",readonly"])
    checked(*PODMAN, "create", *flags, IMAGE)


def remove(info):
    cid = info["Id"]
    if info["State"]["Running"]:
        # The browser handles SIGTERM by flushing its own profile. Wait before removing the namespace.
        execute(*PODMAN, "exec", cid, "/bin/sh", "-c",
                'pid=$(cat "$XDG_RUNTIME_DIR/browser.pid") || exit 0; '
                'kill -TERM "$pid" 2>/dev/null || exit 0; '
                'i=0; while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 30 ]; do sleep .1; i=$((i+1)); done',
                timeout=8)
        checked(*PODMAN, "stop", "--time=8", cid, timeout=20)
    checked(*PODMAN, "rm", "--force", cid, timeout=20)


def network_state(sandbox):
    if not gateway("status", sandbox):
        return "offline"
    probe = execute(str(NETWORK / "probe"), sandbox, timeout=6)
    if probe.returncode == 0:
        return "online"
    return "gateway-ready" if probe.returncode == 2 else "offline"


LEASES = Path("/run/orangespace/leases")   # written by the gateway; tmpfs only


def lease(sandbox, node, stream, info):
    """Take a new node lease from the client; a running desktop reconnects with it."""
    raw = stream.read(MAX_POLICY_BYTES + 1)
    if not raw or len(raw) > MAX_POLICY_BYTES:
        raise DesktopError("node lease must be between 1 and 32768 bytes")
    try:
        result = subprocess.run([str(NETWORK / "lease"), sandbox, node], input=raw,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=10)
    except subprocess.TimeoutExpired as exc:
        raise DesktopError("node lease timed out") from exc
    if result.returncode:
        raise DesktopError("node lease rejected")
    if info and info["State"]["Running"]:
        if info["Config"]["Labels"][LABEL + "node"] != node:
            raise DesktopError("lease is for another node than the running desktop")
        # New tunnel credentials: rebuild the gateway; the desktop keeps running.
        if not gateway("up", sandbox, str(info["State"]["Pid"]), node):
            disconnect(sandbox)


def renew(sandbox, tunnel, remaining_ms):
    if not gateway("renew", sandbox, tunnel, str(remaining_ms)):
        raise DesktopError("lease renewal rejected")


def stop(sandbox, info):
    # Network first, then the desktop, then its display and window; report the first failure.
    # The lease goes with the network: a stopped desktop keeps no node credentials,
    # and the next start needs a new lease from the client anyway.
    try:
        disconnect(sandbox)
    finally:
        try:
            (LEASES / (sandbox + ".json")).unlink(missing_ok=True)
            if info:
                remove(info)
        finally:
            stop_display(sandbox)


def open_desktop(user, sandbox, node, title, directory, info):
    slot = slot_of(directory)
    if info and info["State"]["Running"] and display_running(sandbox):
        open_window(sandbox, slot)   # already running: reopen its window if it was closed
        return info
    disconnect(sandbox)
    if info:
        remove(info)
    display, number = start_display(sandbox, slot, title)
    open_window(sandbox, slot)
    create(user, sandbox, node, directory, slot, display, number)
    checked(*PODMAN, "start", container_name(sandbox))
    info = inspect(sandbox, user)
    if not info or not info["State"]["Running"]:
        raise DesktopError("desktop container failed to start")
    cid = info["Id"]
    # The gateway attaches to the container's network namespace before any
    # application starts. Without a usable node the desktop stays offline.
    if not gateway("up", sandbox, str(info["State"]["Pid"]), node):
        disconnect(sandbox)
    checked(*PODMAN, "exec", cid, "touch", f"/run/user/{GUEST_UID}/launch")
    deadline = time.monotonic() + 60
    while (remaining := deadline - time.monotonic()) > 0:
        try:
            if not execute(*PODMAN, "exec", cid, "/usr/local/bin/desktop-ready", "--initial",
                           timeout=min(4, remaining)).returncode:
                return info
        except DesktopError:
            pass
        time.sleep(min(0.35, remaining))
    raise DesktopError("desktop window manager or Chromium did not become ready")


def describe(user, sandbox, info):
    running = bool(info and info["State"]["Running"])
    return {"user_id": user, "sandbox_id": sandbox,
            "node_id": info["Config"]["Labels"][LABEL + "node"] if info else None,
            "desktop": "running" if running and display_running(sandbox) else "stopped",
            "window": "open" if running and window_open(sandbox) else "closed",
            "network": network_state(sandbox) if running else "offline"}


def file_name(value):
    """One visible path component: no separators, control characters or dot names."""
    if (not value or value.startswith(".") or "/" in value or len(value.encode("utf-8")) > 255
            or any(ord(c) < 32 or ord(c) == 127 for c in value)):
        raise DesktopError("invalid file name")
    return value


def downloads(user, sandbox):
    """This sandbox's Downloads directory, opened as the sandbox's own UID.

    Only the HOME directory is opened as root (its parents belong to root, so
    it cannot be redirected); the process then gives up root for good."""
    with ownership(user, sandbox, claim=False) as directory:
        if not (directory / "owner").exists() or not (directory / "slot").exists():
            raise DesktopError("this sandbox has no desktop data yet; open it once first")
        uid = host_uid(slot_of(directory))
        home = os.open(directory / "home", os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    os.setgroups([])
    os.setresgid(uid, uid, uid)
    os.setresuid(uid, uid, uid)
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC
    try:
        return os.open(DOWNLOADS, flags, dir_fd=home)
    except FileNotFoundError:
        os.mkdir(DOWNLOADS, 0o700, dir_fd=home)
        return os.open(DOWNLOADS, flags, dir_fd=home)
    except OSError:
        raise DesktopError("the Downloads folder is not a directory") from None
    finally:
        os.close(home)


def list_files(folder):
    files = []
    with os.scandir(folder) as entries:
        for entry in entries:
            name = entry.name
            if name.startswith(".") or name.endswith(HIDDEN_SUFFIXES):
                continue
            try:
                name.encode("utf-8")
                info = entry.stat(follow_symlinks=False)
            except (UnicodeEncodeError, OSError):
                continue
            if stat.S_ISREG(info.st_mode):
                files.append({"name": name, "size": info.st_size, "modified_ns": info.st_mtime_ns})
    files.sort(key=lambda f: f["name"])
    return files[:MAX_LISTED]


def free_name(folder, name):
    """name, or "name (1).ext", "name (2).ext", ... : never replaces a file."""
    stem, dot, extension = name.rpartition(".")
    if not stem:
        stem, dot, extension = name, "", ""
    for n in range(1000):
        candidate = name if n == 0 else f"{stem} ({n}){dot}{extension}"
        if len(candidate.encode("utf-8")) > 255:
            continue
        try:
            os.stat(candidate, dir_fd=folder, follow_symlinks=False)
        except FileNotFoundError:
            yield candidate
    raise DesktopError("too many files with this name")


def put_file(folder, name, size, stream):
    temp = "." + uuid.uuid4().hex + ".part"
    out = os.open(temp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600,
                  dir_fd=folder)
    try:
        try:
            remaining = size
            while remaining:
                chunk = stream.read(min(COPY_CHUNK, remaining))
                if not chunk:
                    raise DesktopError("the transfer ended early")
                view = memoryview(chunk)
                while view:
                    view = view[os.write(out, view):]
                remaining -= len(chunk)
            if stream.read(1):
                raise DesktopError("more data than announced")
            os.fsync(out)
        finally:
            os.close(out)
        for candidate in free_name(folder, name):
            try:
                # linkat without following: publishes the finished file under a free name.
                os.link(temp, candidate, src_dir_fd=folder, dst_dir_fd=folder, follow_symlinks=False)
                return candidate
            except FileExistsError:
                continue
    finally:
        with contextlib.suppress(OSError):
            os.unlink(temp, dir_fd=folder)


def get_file(folder, name, out):
    source = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=folder)
    try:
        info = os.fstat(source)
        if not stat.S_ISREG(info.st_mode):
            raise DesktopError("not a regular file")
        out.write(json.dumps({"size": info.st_size}).encode() + b"\n")
        try:
            remaining = info.st_size
            while remaining:
                chunk = os.read(source, min(COPY_CHUNK, remaining))
                if not chunk:
                    raise DesktopError("the file changed while it was read")
                out.write(chunk)
                remaining -= len(chunk)
            out.flush()
        except (DesktopError, OSError):
            # Past the header every stdout byte is file data: fail by exit status alone.
            os._exit(1)
    finally:
        os.close(source)


def files(op, user, sandbox, args):
    user, sandbox = identifier(user), identifier(sandbox)
    if op == "files-list" and not args:
        folder = downloads(user, sandbox)
        return {"user_id": user, "sandbox_id": sandbox, "files": list_files(folder)}
    if op == "files-put" and len(args) == 2:
        name, size = file_name(args[0]), args[1]
        if not size.isdecimal() or int(size) > 1 << 40:
            raise DesktopError("invalid file size")
        folder = downloads(user, sandbox)
        return {"user_id": user, "sandbox_id": sandbox, "name": put_file(folder, name, int(size), sys.stdin.buffer),
                "size": int(size)}
    if op == "files-get" and len(args) == 1:
        name = file_name(args[0])
        folder = downloads(user, sandbox)
        get_file(folder, name, sys.stdout.buffer)
        return None
    raise ValueError("usage: desktop files-list USER SANDBOX | files-put USER SANDBOX NAME SIZE |"
                     " files-get USER SANDBOX NAME")


def run(op, user, sandbox, node=None, title=None, policy_stream=None, remaining_ms=None):
    user, sandbox = identifier(user), identifier(sandbox)
    if op in ("start", "lease"):
        node = identifier(node)
    if op == "renew":
        node = identifier(node)  # the tunnel ID
        if not remaining_ms.isdecimal() or not 0 < int(remaining_ms) <= 30000:
            raise DesktopError("invalid lease budget")
    if op == "start":
        title = window_title(title)
    with ownership(user, sandbox, claim=op in ("start", "lease")) as directory:
        if op == "renew":
            # Every few seconds per sandbox: the gateway checks the tunnel, no container query.
            renew(sandbox, node, int(remaining_ms))
            return {"user_id": user, "sandbox_id": sandbox, "tunnel_id": node, "renewed": True}
        info = inspect(sandbox, user) if directory.exists() else None
        if op == "lease":
            lease(sandbox, node, policy_stream if policy_stream is not None else sys.stdin.buffer, info)
            return describe(user, sandbox, info)
        if op == "start":
            if info and info["State"]["Running"] and info["Config"]["Labels"][LABEL + "node"] != node:
                raise DesktopError("stop the desktop before changing its bound node")
            try:
                info = open_desktop(user, sandbox, node, title, directory, info)
            except (DesktopError, OSError):
                stop(sandbox, inspect(sandbox, user))
                raise
        elif op == "stop":
            stop(sandbox, info)
            info = None
        elif op == "delete":
            stop(sandbox, info)
            # Local data only (HOME, browser profile, node lease). Files on
            # nodes are never deleted from here.
            if directory.exists():
                shutil.rmtree(directory)
            (LEASES / (sandbox + ".json")).unlink(missing_ok=True)
            return {"user_id": user, "sandbox_id": sandbox, "deleted": True}
        return describe(user, sandbox, info)


def main(args):
    try:
        if os.geteuid() != 0:
            raise DesktopError("root is required")
        os.umask(0o077)
        if args and args[0].startswith("files-") and len(args) >= 3:
            result = files(args[0], args[1], args[2], args[3:])
            if result is None:
                return 0
        elif len(args) == 5 and args[0] == "start":
            result = run("start", args[1], args[2], args[3], args[4])
        elif len(args) == 4 and args[0] == "lease":
            result = run(args[0], args[1], args[2], args[3])
        elif len(args) == 5 and args[0] == "renew":
            result = run("renew", args[1], args[2], args[3], remaining_ms=args[4])
        elif len(args) == 3 and args[0] in ("status", "stop", "delete"):
            result = run(args[0], args[1], args[2])
        else:
            raise ValueError("usage: desktop start USER SANDBOX NODE TITLE | lease USER SANDBOX NODE |"
                             " renew USER SANDBOX TUNNEL REMAINING_MS | status/stop/delete USER SANDBOX")
        print(json.dumps(result, ensure_ascii=False))
    except (DesktopError, ValueError, OSError) as exc:
        print(json.dumps({"error": str(exc)}, ensure_ascii=False))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
